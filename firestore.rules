rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // DEVELOPMENT MODE - More permissive rules
    // In production, you should integrate Clerk with Firebase Custom Tokens
    // or use Firebase Admin SDK exclusively on the server
    
    // Users collection - allow authenticated access
    match /users/{userId} {
      allow read, write: if request.auth != null || true; // Allow for development
    }
    
    // Bills collection - allow read/write during development
    match /bills/{billId} {
      allow read, write: if true; // Allow all during development
      
      // Bill Items subcollection
      match /bill_items/{itemId} {
        allow read, write: if true;
        
        // Assignments subcollection
        match /assignments/{assignmentId} {
          allow read, write: if true;
        }
      }
      
      // Activity Logs subcollection
      match /activity_logs/{logId} {
        allow read, write: if true;
      }
    }
  }
}
